#!/usr/bin/env bash
# Dog Rescue — single point of entry for the interactive CLI menu.
#
# Usage:
#   ./dogs                 launch the menu
#   ./dogs --version       print a short banner
#
set -euo pipefail
cd "$(dirname "$0")"

if [ "${1:-}" = "--version" ]; then
    echo "Dog Rescue CLI"
    exit 0
fi

# Prefer the project venv; fall back to `uv run`, then system python3.
if [ -x .venv/bin/python3 ]; then
    exec .venv/bin/python3 cli.py "$@"
fi
if command -v uv >/dev/null 2>&1; then
    exec uv run python cli.py "$@"
fi
exec python3 cli.py "$@"
